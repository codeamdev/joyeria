# Copiar a .env y completar con valores reales. Nunca commitear .env.

# Cadena de conexión a PostgreSQL. Usar un rol de aplicación con privilegios
# mínimos (NO el superusuario postgres). Ver README para el script de creación.
DATABASE_URL="postgresql://joyeria_app:CAMBIA_ESTA_PASSWORD@localhost:5432/joyeria?schema=public"

# Secreto de sesión de Auth.js — generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# URL pública del sitio (usada por Auth.js para construir callbacks)
AUTH_URL="http://localhost:3000"

# Carpeta absoluta, FUERA del repositorio, donde se guardan imágenes/video subidos.
# En el servidor de producción: algo como /var/lib/joyeria/uploads
UPLOADS_DIR="/absolute/path/outside/repo/uploads"

NODE_ENV="development"
