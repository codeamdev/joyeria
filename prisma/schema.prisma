// Joyería y Platería AJ — esquema de datos
// Convenciones: nombres de modelo en PascalCase/singular, tablas en snake_case/plural vía @@map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

enum MaterialType {
  ORO
  PLATA
  ORO_PLATA
  OTRO
}

enum ProductStatus {
  DISPONIBLE
  RESERVADO
  VENDIDO
  HECHO_A_PEDIDO
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  order       Int      @default(0)

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("categories")
}

model Product {
  id               String   @id @default(cuid())
  sku              String   @unique
  name             String
  slug             String   @unique
  description      String?  @db.Text
  shortDescription String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  material MaterialType
  purity   String? // ej. "18k", "14k", "925"

  weightGrams Decimal? @db.Decimal(10, 2)

  price        Decimal @db.Decimal(12, 2)
  internalCost Decimal? @db.Decimal(12, 2) // solo visible en admin

  isOneOfAKind Boolean @default(false)

  isCustomizable     Boolean @default(false)
  productionTimeDays Int?

  status ProductStatus @default(DISPONIBLE)

  careInstructions String? @db.Text

  // Dimensiones — opcionales según tipo de pieza (anillo, cadena, pulsera, etc.)
  ringSize          String?
  chainLengthCm     Decimal? @db.Decimal(6, 2)
  braceletLengthCm  Decimal? @db.Decimal(6, 2)
  dimensionsNote    String?

  certifyingEntity    String?
  certificationNumber String?

  metaTitle       String?
  metaDescription String?

  featured Boolean @default(false)

  gemstones Gemstone[]
  images    ProductImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@index([material])
  @@index([isOneOfAKind])
  @@map("products")
}

model Gemstone {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  type     String // ej. diamante, esmeralda, rubí, zafiro, perla (lista abierta, curada en la UI)
  carat    Decimal? @db.Decimal(6, 3)
  color    String?
  clarity  String?
  cut      String?
  quantity Int      @default(1)

  @@index([productId])
  @@map("gemstones")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url     String
  order   Int     @default(0)
  isMain  Boolean @default(false)
  altText String?

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// Hero de inicio
// ---------------------------------------------------------------------------

// Fila única (singleton). El tipo mostrado (video vs carrusel) se DERIVA en la
// capa de aplicación a partir de videoUrl/images, nunca se persiste: así nunca
// puede quedar desincronizado del contenido real (regla de negocio: video > carrusel).
model HeroConfig {
  id String @id @default(cuid())

  videoUrl      String?
  videoPosterUrl String?

  images HeroImage[]

  updatedAt DateTime @updatedAt

  @@map("hero_config")
}

model HeroImage {
  id           String     @id @default(cuid())
  heroConfigId String
  heroConfig   HeroConfig @relation(fields: [heroConfigId], references: [id], onDelete: Cascade)

  url     String
  order   Int     @default(0)
  altText String?

  createdAt DateTime @default(now())

  @@index([heroConfigId])
  @@map("hero_images")
}

// ---------------------------------------------------------------------------
// Contenido de marca / historia
// ---------------------------------------------------------------------------

// Fila única (singleton) con datos generales de contacto y despliegue de la marca.
model SiteSettings {
  id String @id @default(cuid())

  whatsappNumber String?
  contactEmail   String?
  contactPhone   String?
  address        String?

  storyTitle String?
  storyIntro String? @db.Text

  instagramUrl String?
  facebookUrl  String?
  tiktokUrl    String?

  currency String @default("COP")

  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// Bloques editables para el storytelling con scroll de "Nuestra historia / Proceso artesanal".
model StorySection {
  id String @id @default(cuid())

  order    Int
  title    String
  body     String  @db.Text
  imageUrl String?
  videoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("story_sections")
}

// ---------------------------------------------------------------------------
// Solicitudes públicas
// ---------------------------------------------------------------------------

enum InquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

model ContactMessage {
  id String @id @default(cuid())

  name    String
  email   String
  phone   String?
  subject String?
  message String  @db.Text

  status InquiryStatus @default(NEW)

  ipAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("contact_messages")
}

model CustomOrderRequest {
  id String @id @default(cuid())

  name  String
  email String
  phone String?

  pieceType       String
  desiredMaterial String?
  budgetRange     String?
  referenceImageUrl String?
  message         String? @db.Text

  status InquiryStatus @default(NEW)

  ipAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("custom_order_requests")
}

// ---------------------------------------------------------------------------
// Administración
// ---------------------------------------------------------------------------

enum AdminRole {
  ADMIN
  EDITOR
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)

  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
}

model AuditLog {
  id String @id @default(cuid())

  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  action     AuditAction
  entityType String
  entityId   String?
  changes    Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([adminUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
